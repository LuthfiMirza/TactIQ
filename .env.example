# ==============================================================================
# TactIQ Platform - Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=tactiq_user
POSTGRES_PASSWORD=tactiq_secure_password
POSTGRES_DB=tactiq_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Prisma Connection URL (Used by apps/api)
# Local development: postgresql://tactiq_user:tactiq_secure_password@localhost:5432/tactiq_db?schema=public
# Docker network:    postgresql://tactiq_user:tactiq_secure_password@postgres:5432/tactiq_db?schema=public
DATABASE_URL=postgresql://tactiq_user:tactiq_secure_password@localhost:5432/tactiq_db?schema=public

# ------------------------------------------------------------------------------
# 2. Redis (Pub/Sub & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CHANNEL=tactiq_tracking_stream

# ------------------------------------------------------------------------------
# 3. API Gateway (apps/api - Express + Socket.io)
# ------------------------------------------------------------------------------
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Machine Learning Microservice (services/ml - FastAPI)
# ------------------------------------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8000
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Front-End Web Application (apps/web - Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_ML_URL=http://localhost:8100

# ------------------------------------------------------------------------------
# 6. External Live Sports Data Providers (Multi-Provider Fallback Chain)
# ------------------------------------------------------------------------------
# Data Mode: 'live' to query external APIs, 'demo' to use seeded authentic DB
DATA_MODE=live

# Provider 1 (Utama - Live Scores, Lineups 2D, Events, Stats & xG)
# Free Tier: 100 req/day (reset 00:00 UTC). Daftar di: https://dashboard.api-football.com/
API_FOOTBALL_KEY=

# Provider 2 (Cadangan 1 - Live Scores, Lineups, Standings)
# Free Tier: 100 req/day. Daftar di: https://rapidapi.com/ atau Highlightly portal
HIGHLIGHTLY_API_KEY=

# Provider 3 (Cadangan 2 - Schedules, Standings, Delayed Scores)
# Free Tier: 10 req/min. Daftar di: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

