// TactIQ Database Schema
// PostgreSQL 16 via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum TrackingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Team {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  logoUrl      String
  league       String
  externalId   String?
  provider     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  players      Player[]
  homeFixtures Fixture[] @relation("HomeTeamFixtures")
  awayFixtures Fixture[] @relation("AwayTeamFixtures")
  homeH2H      H2H[]     @relation("HomeTeamH2H")
  awayH2H      H2H[]     @relation("AwayTeamH2H")
  standing     Standing?

  @@index([name])
  @@index([league])
  @@index([externalId])
  @@map("teams")
}

model Player {
  id          String            @id @default(uuid())
  teamId      String
  name        String
  position    Position
  nationality String
  age         Int
  marketValue Float             // In Euros (e.g. 80000000)
  photoUrl    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attributes  PlayerAttributes?

  @@index([name])
  @@index([position])
  @@index([teamId])
  @@map("players")
}

model PlayerAttributes {
  id        String   @id @default(uuid())
  playerId  String   @unique
  pace      Int      // 0 - 100
  shooting  Int      // 0 - 100
  passing   Int      // 0 - 100
  dribbling Int      // 0 - 100
  defending Int      // 0 - 100
  physical  Int      // 0 - 100
  vision    Int      // 0 - 100
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_attributes")
}

model Fixture {
  id          String      @id @default(uuid())
  homeTeamId  String
  awayTeamId  String
  matchDate   DateTime
  status      MatchStatus @default(SCHEDULED)
  homeScore   Int?
  awayScore   Int?
  venue       String
  externalId  String?
  provider    String?
  source      String      @default("database-seed")
  fetchedAt   DateTime?
  isStale     Boolean     @default(false)
  isDelayed   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  homeTeam    Team        @relation("HomeTeamFixtures", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team        @relation("AwayTeamFixtures", fields: [awayTeamId], references: [id], onDelete: Cascade)

  events      MatchEvent[]
  lineups     MatchLineup[]
  statistics  MatchStatistic[]
  injuries    MatchInjury[]

  @@index([matchDate])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([externalId])
  @@map("fixtures")
}

model H2H {
  id            String   @id @default(uuid())
  teamHomeId    String
  teamAwayId    String
  matchesPlayed Int      @default(0)
  homeWins      Int      @default(0)
  awayWins      Int      @default(0)
  draws         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homeTeam      Team     @relation("HomeTeamH2H", fields: [teamHomeId], references: [id], onDelete: Cascade)
  awayTeam      Team     @relation("AwayTeamH2H", fields: [teamAwayId], references: [id], onDelete: Cascade)

  @@unique([teamHomeId, teamAwayId])
  @@map("h2h_records")
}

model VideoTrackingSession {
  id              String               @id @default(uuid())
  youtubeUrl      String
  matchTitle      String
  status          TrackingStatus       @default(PENDING)
  durationSeconds Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  coordinates     TrackingCoordinate[]

  @@map("video_tracking_sessions")
}

model TrackingCoordinate {
  id          String               @id @default(uuid())
  sessionId   String
  timestampMs Int                  // Milliseconds into video
  frameNumber Int                  // Frame sequence index
  playersData Json                 // JSONB array: [{ id: number, teamSide: 'home' | 'away' | 'ball', xNorm: number, yNorm: number }]
  createdAt   DateTime             @default(now())

  session     VideoTrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, frameNumber])
  @@index([sessionId, timestampMs])
  @@map("tracking_coordinates")
}

model Standing {
  id             String   @id @default(uuid())
  teamId         String   @unique
  position       Int
  played         Int      @default(0)
  won            Int      @default(0)
  drawn          Int      @default(0)
  lost           Int      @default(0)
  goalsFor       Int      @default(0)
  goalsAgainst   Int      @default(0)
  goalDifference Int      @default(0)
  points         Int      @default(0)
  externalId     String?
  provider       String?
  source         String   @default("database-seed")
  fetchedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([position])
  @@map("league_standings")
}

// ---------------------------------------------------------
// FASE 2: Live Ingestion Models & Provider Data Persistence
// ---------------------------------------------------------

model MatchEvent {
  id          String   @id @default(uuid())
  fixtureId   String
  minute      Int
  extraMinute Int?
  teamName    String
  playerName  String
  assistName  String?
  type        String   // 'Goal', 'Card', 'subst', 'Var'
  detail      String?  // 'Normal Goal', 'Yellow Card', etc.
  source      String   @default("api-football")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
  @@index([minute])
  @@map("match_events")
}

model MatchLineup {
  id          String   @id @default(uuid())
  fixtureId   String
  teamSide    String   // 'home' | 'away'
  teamName    String
  formation   String   // e.g. '4-3-3', '4-2-3-1'
  coachName   String?
  startXI     Json     // [{ id, number, name, pos, grid }]
  substitutes Json     // [{ id, number, name, pos }]
  source      String   @default("api-football")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamSide])
  @@map("match_lineups")
}

model MatchStatistic {
  id          String   @id @default(uuid())
  fixtureId   String
  period      String   @default("ALL") // 'ALL', '1ST', '2ND'
  homeStats   Json     // { possession, shotsTotal, shotsOnTarget, passes, passAccuracy, corners, fouls, xG }
  awayStats   Json     // { possession, shotsTotal, shotsOnTarget, passes, passAccuracy, corners, fouls, xG }
  source      String   @default("api-football")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, period])
  @@map("match_statistics")
}

model MatchInjury {
  id          String   @id @default(uuid())
  fixtureId   String
  teamName    String
  playerName  String
  type        String?  // 'Missing Fixture' | 'Questionable'
  reason      String?  // e.g. 'Hamstring Injury'
  source      String   @default("api-football")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fixture     Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
  @@map("match_injuries")
}

model ProviderMapping {
  id          String   @id @default(uuid())
  provider    String   // e.g. 'api-football', 'football-data'
  entityType  String   // 'team' | 'fixture' | 'player' | 'league'
  internalId  String
  externalId  String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, entityType, externalId])
  @@index([internalId])
  @@map("provider_mappings")
}

model ProviderFixtureMap {
  id                String   @id @default(uuid())
  provider          String   // 'api-football' | 'highlightly' | 'football-data'
  providerFixtureId String
  internalFixtureId String?
  matchKey          String   // e.g. "Arsenal_Chelsea_2026-10-01"
  status            String   @default("resolved") // "resolved" | "unresolved"
  kickoff           DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerFixtureId])
  @@index([internalFixtureId])
  @@index([matchKey])
  @@map("provider_fixture_map")
}

